# Copy to .env and change the values. .env is git-ignored.
POSTGRES_PASSWORD=change-me
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
# Host ports (change if they're already in use on your machine)
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
